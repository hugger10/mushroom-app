# Electron app environment configuration.
# Read by both the main process (process.env) and the renderer (VITE_* via Vite).

# --- Main process ---

# Logging
# Level: debug | info | warn | error
# Default: debug when running unpackaged, info when packaged.
LOG_LEVEL=debug
# Maximum size (MB) of a single rotated log file.
LOG_MAX_FILE_MB=50
# Number of days of log files to keep; older daily files are deleted on startup.
LOG_RETENTION_DAYS=14

# Base URL the Electron main process uses for outbound HTTP requests.
API_BASE_URL=http://127.0.0.1:9100

# --- Renderer (Vite) ---
# These VITE_* variables are inlined into the renderer bundle. The renderer
# source is shared with apps/web, but each app maintains its own values here.

VITE_API_BASE_URL=/api
VITE_WS_URL=
VITE_DEV_PROXY_TARGET=http://127.0.0.1:9100

# Optional fallback when /auth/call/ice is unavailable.
# Example:
# VITE_CALL_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478"],"username":"demo","credential":"demo"}]
VITE_CALL_ICE_SERVERS=
VITE_CALL_FORCE_RELAY=false
VITE_CALL_DEBUG_MEDIA=false
