# Mobile app environment configuration.
# IMPORTANT: This file is bundled into the native binary at build time
# via react-native-config. NEVER place server-side secrets here.

# API server base URL.
# Overrides the built-in default (http://127.0.0.1:9100 in dev,
# https://mushroom.top in production).
# Examples:
#   API_BASE_URL=http://192.168.1.100:9100   (LAN IP — phone on same WiFi)
#   API_BASE_URL=http://127.0.0.1:9100         (with adb reverse)
#   API_BASE_URL=https://api.myserver.com      (production)
# Leave empty to use the built-in fallback.
API_BASE_URL=

# Logging
# Level: debug | info | warn | error
# Default: debug when __DEV__, info otherwise.
LOG_LEVEL=info

# Whether to persist logs to local files (in addition to console).
# Set to false to disable file output entirely.
LOG_TO_FILE=true

# Maximum size (MB) of a single log file before rolling over.
LOG_MAX_FILE_MB=5

# Number of days of log files to retain. Older files are deleted at startup.
LOG_RETENTION_DAYS=7

# JPush (极光) AppKey — 可选厂商通道。留空则设备按现有
# xiaomi → huawei → fcm 优先级注册。从极光控制台创建应用获取。
# JPUSH_APPKEY=
# JPush iOS 推送环境：true 生产 / false 沙盒。
# JPUSH_PRODUCTION=false

# 小米推送（MiPush）客户端注册凭据 — 非极光路径下小米设备的厂商通道。
# 从小米开放平台（dev.mi.com）创建推送应用获取；留空则小米通道不启用。
# PUSH_XIAOMI_APP_ID=
# PUSH_XIAOMI_APP_KEY=
# 小米推送区域（singapore/europe/russia/india/global），默认 singapore。
# PUSH_XIAOMI_REGION=
