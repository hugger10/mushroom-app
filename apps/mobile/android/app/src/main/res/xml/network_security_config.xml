<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Base configuration: deny cleartext (HTTP) traffic by default.
        Individual domain-config blocks below explicitly grant cleartext
        for trusted dev/staging servers.  This is the recommended approach
        on Android 7.0+ (API 24+) since it works reliably across all OEM
        ROMs, including those that ignore usesCleartextTraffic.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        Development / local servers: Android emulator loopback, localhost,
        and adb-reverse forwarded ports.  These never carry production data
        so cleartext is safe.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>

    <!--
        Staging / production-like server accessed over plain HTTP.
        Update this IP when the server address changes.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">118.25.26.5</domain>
    </domain-config>

    <!--
        Production domain — HTTPS only, trust system certificate authorities.
        Subdomains are included so that api.mushroom.top, ws.mushroom.top, etc.
        are all covered.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">mushroom.top</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
