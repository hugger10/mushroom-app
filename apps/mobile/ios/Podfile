# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native-permissions/scripts/setup.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

setup_permissions([
  'Camera',
  'Microphone',
])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Mesh' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # react-native-ios-utilities is a direct dependency of @mushroom/mobile, so
  # RN autolinking provides its pod and codegen generates the RNIUtilitiesSpec
  # headers. It is NOT published to the CocoaPods trunk source, but autolinking
  # resolves it from the installed npm package's podspec.

  # Firebase's Swift pod (FirebaseCoreInternal) imports GoogleUtilities from
  # Swift, which requires GoogleUtilities (and the pod importing it) to generate
  # module maps. Enable modular headers only for these two targets — a global
  # `use_modular_headers!` or `use_frameworks!` would break JCore/JPush (their
  # podspecs do not declare static_framework).
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
