{
  "name": "@mushroom/shared",
  "version": "1.0.0",
  "description": "Shared business logic and utilities",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/api/index.ts src/types/index.ts src/logger/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts src/api/index.ts src/types/index.ts src/logger/index.ts --format esm,cjs --dts --watch --clean",
    "test": "pnpm build && node --test test/**/*.test.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {},
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.mjs",
      "require": "./dist/api/index.js",
      "default": "./dist/api/index.mjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js",
      "default": "./dist/types/index.mjs"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "import": "./dist/logger/index.mjs",
      "require": "./dist/logger/index.js",
      "default": "./dist/logger/index.mjs"
    }
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
