# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=9100
SERVER_NODE_ID=0.0.0.0:9100
SERVER_GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
JWT_ACCESS_TTL_SECONDS=86400
JWT_REFRESH_TTL_SECONDS=2592000
# Seconds the previously rotated refresh token is still accepted, to absorb
# concurrent refresh attempts. Default 30.
JWT_REFRESH_GRACE_SECONDS=30
# Seconds the previously rotated access_jti is still accepted, to absorb
# in-flight requests issued just before a refresh. Default 30.
JWT_ACCESS_GRACE_SECONDS=30
JWT_SECRET=dev-secret-change-me
LOG_LEVEL=debug
LOG_TO_FILE=false
LOG_DIR=./logs

# Payload sampling (off by default). Open only for ad-hoc troubleshooting.
# See docs/architecture/logging.md §13 for full semantics.
LOG_PAYLOAD_ENABLED=false
# Comma-separated allowlist; empty means all scopes pass:
#   ws.chat.in / ws.recv / outbox.deliver.chat / push.envelope / http.body
LOG_PAYLOAD_SCOPES=
LOG_PAYLOAD_MAX_BYTES=2048
LOG_PAYLOAD_SAMPLE_RATE=1
# Restrict sampling to specific userIds (comma-separated). Empty = no restriction.
LOG_PAYLOAD_USER_ALLOWLIST=
# Override default redact keys: password,token,access_token,refresh_token,phone,email,authorization
LOG_PAYLOAD_REDACT_KEYS=

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mushroom
DB_USER=mushroom
DB_PASSWORD=mushroom
# Slow query threshold (ms). Queries slower than this log at warn level. 0 disables.
PG_SLOW_QUERY_MS=300
# Connection pool size (per server process).
DB_POOL_MAX=20
# Server-side statement_timeout (ms). Single SQL exceeding this is cancelled by PG.
# Pairs with DB_IDLE_IN_TX_TIMEOUT_MS to keep the pool from being held by slow/stuck queries. 0 disables.
DB_STATEMENT_TIMEOUT_MS=15000
# Server-side idle_in_transaction_session_timeout (ms). A transaction idle for longer
# than this (e.g. waiting on external IO inside BEGIN) is rolled back and the connection dropped. 0 disables.
DB_IDLE_IN_TX_TIMEOUT_MS=30000
# Client-side query_timeout (ms, node-postgres fallback). 0 disables.
DB_QUERY_TIMEOUT_MS=20000

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO
MINIO_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_URL=http://127.0.0.1:9000

# Message / Attachment limits (downstreamed to all clients via GET /api/config/limits)
MAX_TEXT_LENGTH=2000
MAX_AVATAR_SIZE_MB=5
MAX_IMAGE_SIZE_MB=30
MAX_VIDEO_SIZE_MB=300
MAX_AUDIO_SIZE_MB=100
MAX_VOICE_SIZE_MB=50
MAX_FILE_SIZE_MB=200

# Chunked / multipart upload tuning (MinIO presigned PUT)
UPLOAD_CHUNK_SIZE_MB=5
UPLOAD_CHUNK_CONCURRENCY=3
UPLOAD_CHUNK_MAX_RETRIES=3
UPLOAD_PRESIGNED_EXPIRES_SECONDS=3600
UPLOAD_MULTIPART_THRESHOLD_MB=5

# WebSocket / presence heartbeat
# 心跳扫描间隔（毫秒），默认 35000
WS_HEARTBEAT_CHECK_INTERVAL_MS=35000
# 客户端最长无 ping 容忍（毫秒），超过即 terminate，默认 40000
WS_HEARTBEAT_TIMEOUT_MS=40000
# Redis 中 device presence key 的 TTL（秒），心跳时刷新；
# 不变量：WS_HEARTBEAT_CHECK_INTERVAL_MS < WS_DEVICE_PRESENCE_TTL_SECONDS*1000/2
WS_DEVICE_PRESENCE_TTL_SECONDS=70

# Outbox
OUTBOX_ENABLED=true
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_MS=1000
# 单行被一个 worker 租约的时长（毫秒），到期后可被其它 worker 重新抢占
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_RETRY_COUNT=5
OUTBOX_MAX_RETRY_DELAY_MS=60000
OUTBOX_MONITOR_LOG_INTERVAL_MS=60000
# Outbox 历史清理（守护进程）：dispatched 保留 24h，dead 保留 30d，按批 SKIP LOCKED 删除
OUTBOX_DISPATCHED_RETENTION_HOURS=24
OUTBOX_DEAD_RETENTION_DAYS=30
OUTBOX_CLEANUP_INTERVAL_MS=3600000
OUTBOX_CLEANUP_BATCH=5000

# Attachment orphan cleanup：清理超过 TTL 仍未绑定到消息的 attachment_uploads
ATTACHMENT_ORPHAN_TTL_HOURS=24
ATTACHMENT_ORPHAN_CLEANUP_INTERVAL_MS=3600000
ATTACHMENT_ORPHAN_CLEANUP_BATCH=200

# Presence fanout / debounce
# 在线状态扇出模式：contacts | subscribers | both
PRESENCE_FANOUT_MODE=both
# 单个 device 订阅集合在 Redis 中的 TTL（秒），心跳时刷新
PRESENCE_SUBSCRIPTION_DEVICE_TTL_SECONDS=300
# 单次 subscribe 帧最多允许的 user_ids 数
PRESENCE_SUBSCRIBE_BATCH_LIMIT=500
# presence transition 抖动 debounce 窗口（毫秒），0 即关闭
PRESENCE_TRANSITION_DEBOUNCE_MS=3000

# Mobile push delivery (FCM for Android / iOS tokens)
PUSH_ENABLED=true
PUSH_DRY_RUN=true
PUSH_FCM_PROJECT_ID=
PUSH_FCM_CLIENT_EMAIL=
# Use literal \n for line breaks when storing a private key in .env
PUSH_FCM_PRIVATE_KEY=
# JPush (极光) 聚合推送 — 可选厂商通道。客户端构建注入 JPUSH_APPKEY 后设备注册
# push_provider="jpush"；服务端经 api.jpush.cn 投递（国内可达）。appKey /
# masterSecret 从极光控制台创建应用获取。未配置则按 xiaomi→huawei→fcm 优先级。
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
# iOS 推送环境：true 生产 / false 沙盒。默认跟随 isProduction。
JPUSH_APNS_PRODUCTION=
PUSH_HUAWEI_APP_ID=
PUSH_HUAWEI_CLIENT_ID=
PUSH_HUAWEI_CLIENT_SECRET=
# Optional overrides for Huawei Push regional routing
PUSH_HUAWEI_OAUTH_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/token
PUSH_HUAWEI_API_URL=https://push-api.cloud.huawei.com
# Apple PushKit / VoIP (CallKit wake-up for killed/background iOS).
# Only call.invite / call.missed are delivered over the VoIP topic
# (<bundleId>.voip); chat still goes over FCM/APNs push_token.
# Token-based auth: create an APNs Auth Key (.p8) in the Apple Developer portal.
PUSH_APNS_KEY_ID=
PUSH_APNS_TEAM_ID=
# Paste the .p8 contents; use literal \n for line breaks when storing in .env
PUSH_APNS_PRIVATE_KEY=
# App bundle id (the provider appends .voip to derive the apns-topic)
PUSH_APNS_BUNDLE_ID=
# true → api.push.apple.com, false → api.sandbox.push.apple.com
PUSH_APNS_PRODUCTION=false
PUSH_XIAOMI_APP_ID=
PUSH_XIAOMI_APP_KEY=
PUSH_XIAOMI_APP_SECRET=
PUSH_XIAOMI_PACKAGE_NAME=
# xiaomi region: china|global|europe|russia|india
PUSH_XIAOMI_REGION=china
# 2026-08-01 消息分类新规：通知类消息必须携带已审核的 channel_id，否则小米返回
# `invalid channel info!`。到小米推送运营平台「消息分类管理 - channel列表」申请
# （IM 场景走私信消息：好友聊天/群组聊天/音视频通话），审核通过后生成的 channel_id 填这里。
# 私信消息还需模板 id，待平台审核通过后按申请信息补充。
PUSH_XIAOMI_CHANNEL_ID=
# 私信消息的消息模板 id：小米推送运营平台「消息分类管理 - 模板管理 - 官方模板」，
# 无需申请即可使用。IM 好友聊天用官方模板 M12762（标题「您有一条消息来自{发送者}」、
# 内容「{消息内容}」，变量 keywords1=发送者 / keywords2=消息内容）。需与 channel 绑定。
PUSH_XIAOMI_TEMPLATE_ID=
PUSH_XIAOMI_JAVA_BIN=java
# download the official Java Http2 SDK and point this to its directory
PUSH_XIAOMI_SDK_DIR=
# compile server/tools/xiaomi/XiaomiPushCli.java and point this to the classes output dir
PUSH_XIAOMI_HELPER_CLASSPATH=server/tools/xiaomi/classes
# java helper 子进程超时（毫秒）。超时后 Node 会向进程发 SIGTERM，日志里表现为
# killed:true / exit code 143，通常是容器到小米 API 出网卡死导致。
PUSH_XIAOMI_TIMEOUT_MS=20000
# MiPush SDK 层重试次数。出网故障时重试会成倍放大等待时间，默认降为 1 以快速失败，
# 交给 outbox 退避重试兜底。
PUSH_XIAOMI_RETRIES=1

# Realtime calling / TURN
CALL_INVITE_TIMEOUT_SECONDS=45
CALL_GROUP_MAX_PARTICIPANTS=8
CALL_STUN_URLS=stun:stun.l.google.com:19302
CALL_TURN_URLS=
# Preferred: shared-secret auth for coturn REST API style credentials
CALL_TURN_SECRET=
CALL_TURN_TTL_SECONDS=3600
# Optional fallback: static long-term credentials
CALL_TURN_USERNAME=
CALL_TURN_CREDENTIAL=
CALL_LIVEKIT_URL=
CALL_LIVEKIT_API_KEY=
CALL_LIVEKIT_API_SECRET=
CALL_LIVEKIT_TOKEN_TTL_SECONDS=3600
