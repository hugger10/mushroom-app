{
  "name": "@mushroom/server",
  "version": "1.0.0",
  "description": "mushroom",
  "main": "dist/server/src/index.js",
  "scripts": {
    "predev": "pnpm --filter @mushroom/shared build",
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "cross-env NODE_ENV=development ts-node-dev --transpile-only --exit-child src/db/cli-migrate.ts",
    "seed": "cross-env NODE_ENV=development ts-node-dev --transpile-only --exit-child src/db/cli-seed.ts",
    "reset": "cross-env NODE_ENV=development ts-node-dev --transpile-only --exit-child src/db/cli-reset.ts",
    "predev:outbox": "pnpm --filter @mushroom/shared build",
    "dev:outbox": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/outbox/index.ts",
    "prebuild": "pnpm --filter @mushroom/shared build",
    "build": "tsc",
    "test": "pnpm build && cross-env NODE_ENV=test node --test --import ./test/_setup.mjs 'test/**/*.test.mjs'",
    "prestart": "pnpm --filter @mushroom/shared build",
    "start": "cross-env NODE_ENV=production node dist/server/src/index.js",
    "prestart:dev": "pnpm --filter @mushroom/shared build",
    "start:dev": "cross-env NODE_ENV=development node dist/server/src/index.js",
    "prestart:outbox": "pnpm --filter @mushroom/shared build",
    "start:outbox": "cross-env NODE_ENV=production node dist/server/src/outbox/index.js",
    "loadtest:db:direct": "cross-env NODE_ENV=development ts-node-dev --transpile-only --exit-child tools/load-test/seed-direct-db.ts",
    "loadtest:db:group": "cross-env NODE_ENV=development ts-node-dev --transpile-only --exit-child tools/load-test/seed-group-db.ts",
    "loadtest:http:direct": "cross-env NODE_ENV=development ts-node-dev --transpile-only --exit-child tools/load-test/seed-direct-http.ts",
    "loadtest:http:group": "cross-env NODE_ENV=development ts-node-dev --transpile-only --exit-child tools/load-test/seed-group-http.ts",
    "loadtest:ws:direct": "cross-env NODE_ENV=development ts-node-dev --transpile-only --exit-child tools/load-test/seed-direct-ws.ts",
    "loadtest:ws:group": "cross-env NODE_ENV=development ts-node-dev --transpile-only --exit-child tools/load-test/seed-group-ws.ts",
    "loadtest:cleanup": "cross-env NODE_ENV=development ts-node-dev --transpile-only --exit-child tools/load-test/cleanup.ts",
    "loadtest:bulk": "cross-env NODE_ENV=development ts-node-dev --transpile-only --exit-child tools/load-test/seed-bulk-users.ts",
    "loadtest:cleanup:bulk": "cross-env NODE_ENV=development ts-node-dev --transpile-only --exit-child tools/load-test/cleanup-bulk.ts"
  },
  "dependencies": {
    "@akashrajpurohit/snowflake-id": "^2.0.0",
    "@mushroom/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "dotenv": "^16.3.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.4.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.0",
    "minio": "^8.0.5",
    "multer": "^2.0.2",
    "pg": "^8.11.0",
    "pg-promise": "^11.5.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sharp": "^0.34.3",
    "uuid": "^9.0.1",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/body-parser": "^1.19.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/multer": "^2.0.0",
    "@types/pg": "^8.6.6",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "cross-env": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
